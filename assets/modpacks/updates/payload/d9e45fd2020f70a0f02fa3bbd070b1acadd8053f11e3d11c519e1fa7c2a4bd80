// Protect before HP is subtracted, without entering/cancelling the death pipeline.
ForgeEvents.onEvent('net.minecraftforge.event.entity.living.LivingDamageEvent', event => {
  if (typeof global.olyPendantDamage === 'function') global.olyPendantDamage(event)
})
if (Platform.isClientEnvironment()) {
  ForgeEvents.onEvent('net.minecraftforge.client.event.ViewportEvent$ComputeFov', event => {
    const p = Client.player
    if (p && p.isUsingItem() && p.getUseItem().id === 'kubejs:longue_vue_neron') {
      event.setFOV(event.getFOV() * 0.10)
    }
  })
  ForgeEvents.onEvent('net.minecraftforge.event.entity.living.LivingEvent$LivingJumpEvent', event => {
    const p=Client.player
    if(p && String(event.getEntity().getUuid())===String(p.getUuid()) &&
       (Date.now()<(global.olyClientNoJumpUntil || 0) || Date.now()<(global.olyClientComaUntil || 0))) {
      p.motionY=0
    }
  })
}

// Hide only the vanilla bottom HUD and duplicate crosshair while using Neron.
if(Platform.isClientEnvironment()) {
  var OLY_SCOPE_HIDDEN={hotbar:true,player_health:true,armor_level:true,food_level:true,air_level:true,mount_health:true,jump_bar:true,experience_bar:true,item_name:true,crosshair:true,record_overlay:true}
  ForgeEvents.onEvent('net.minecraftforge.client.event.RenderGuiOverlayEvent$Pre',event=>{
    var p=Client.player
    if(!p || !p.isUsingItem() || p.getUseItem().id!=='kubejs:longue_vue_neron')return
    var id=String(event.getOverlay().id())
    if(id.indexOf('minecraft:')===0 && OLY_SCOPE_HIDDEN[id.slice(10)])event.setCanceled(true)
  })
}

ForgeEvents.onEvent('net.minecraftforge.event.entity.living.LivingFallEvent',event=>{var entity=event.getEntity();if(!entity || !entity.player || entity.level.clientSide || !entity.server)return;if(typeof global.olyPotatoFall==='function')global.olyPotatoFall(event)})
