  return String(text).toLowerCase().replace(/[àâäáãå]/g,'a').replace(/[éèêë]/g,'e').replace(/[îïí]/g,'i').replace(/[ôöóõ]/g,'o').replace(/[ùûüú]/g,'u').replace(/ç/g,'c').replace(/œ/g,'oe').replace(/æ/g,'ae').replace(/[^a-z0-9]+/g,' ').trim()
}
function olyTicketMatch(text){
  var input=' '+olyTicketNormalize(text)+' ',best=null,score=0
  OLY_TICKET_CATALOG.forEach(topic=>topic.aliases.forEach(alias=>{
    var a=olyTicketNormalize(alias),matched=input.indexOf(' '+a+' ')>=0
    if(!matched && a.indexOf(' ')<0 && a.charAt(a.length-1)!=='s')matched=input.indexOf(' '+a+'s ')>=0
    var rank=a.length+(topic.key==='bug'?0:1000)
    if(matched && rank>score){best=topic;score=rank}
  }))
  return best
}
function olyTicketPick(topic){
  var pool=topic.rewards,total=0;pool.forEach(r=>total+=r.weight)
  var roll=Math.random()*total
  for(var i=0;i<pool.length;i++){roll-=pool[i].weight;if(roll<0)return pool[i]}
  return pool[pool.length-1]
}
function olyTicketRewardKey(item){return 'ticket_catalog_'+item.replace(/[^a-z0-9]/g,'_')}
var OLY_TICKET_DELIVERIES={}
OLY_TICKET_CATALOG.forEach(topic=>(topic.rewards || []).forEach(r=>{OLY_TICKET_DELIVERIES[olyTicketRewardKey(r.item)]=r.item}))

// Resolve first, then queue compensation until the recipient is alive and online.
function olyDeliverTicket(p) {
  if(!p.isAlive())return
  var rewards=[['ticket_dirt','minecraft:dirt'],['ticket_iron','minecraft:iron_ingot'],['ticket_slime','minecraft:slime_ball'],['ticket_chair','handcrafted:oak_chair'],['ticket_clock','minecraft:clock'],['ticket_flower','minecraft:poppy'],['ticket_barrel','minecraft:barrel']]
  rewards.forEach(pair=>{
    var count=olyRead(p,pair[0])
    if(count>0){olyWrite(p,pair[0],0);p.give(Item.of(pair[1],count))}
  })
  Object.keys(OLY_TICKET_DELIVERIES).forEach(key=>{var count=olyRead(p,key);if(count>0){olyWrite(p,key,0);p.give(Item.of(OLY_TICKET_DELIVERIES[key],count))}})
  var xp=olyRead(p,'ticket_xp');if(xp>0){olyWrite(p,'ticket_xp',0);p.addXP(xp)}
  if(olyRead(p,'ticket_haste')>0){olyWrite(p,'ticket_haste',0);olyFx(p,'haste',60,0)}
}

function olyRecoverTickets(p){
  if(!p.isAlive())return
  var key=String(p.getUuid()),active=olyActiveTickets[key] || 0
  var missing=olyRead(p,'ticket_unresolved')-active
  if(missing>0){olyWrite(p,'ticket_unresolved',active);p.give(Item.of('kubejs:ticket_romain',missing));p.setStatusMessage('§7Ticket récupéré après une interruption.')}
}
function olyCooldown(p,key,seconds) {
  if (olyRead(p,key)>olyNow()) { p.setStatusMessage('§7Cet objet est encore en recharge.'); return false }
  olyWrite(p,key,olyNow()+seconds*1000); return true
}
function olyPending(p,key,time) { olyWrite(p,key,time) }
function olyPendant(p) {
  var inv = OlyCurios.getCuriosInventory(p).resolve()
  if (!inv.isPresent()) return null
  var slots=inv.get().getEquippedCurios()
  for (var i=0;i<slots.getSlots();i++) {
    var s=slots.getStackInSlot(i)
    if (s.id==='kubejs:pendentif_mathis' && s.count>0) return s
  }
  return null
}
function olyMigrateBrain(p) {
  if(olyRead(p,'brain_timer_version')>=2)return
  var oldNext=olyRead(p,'brain_next')
  if(oldNext>0)olyWrite(p,'brain_next',Math.max(0,oldNext-86400000+OLY_BRAIN_COOLDOWN_MS))
  olyWrite(p,'brain_timer_version',2)
}
function olyDeliverBrain(p,reconnect) {
  var raw=p.server.persistentData.getString(olyKey(p,'brain_prize'))
  if(!raw || !p.isAlive())return false
  if(olyRead(p,'brain_ready')!==1 && (!reconnect || olyNow()<olyRead(p,'brain_reveal_at')))return false
  var prize=JSON.parse(String(raw))
  p.server.persistentData.putString(olyKey(p,'brain_prize'),'')
  olyWrite(p,'brain_ready',0)
  p.give(Item.of(prize.id,prize.id==='minecraft:enchanted_book'?{StoredEnchantments:prize.enchantments}:{Enchantments:prize.enchantments}))
  return true
}
