function olyCleanBridges(server){
 var raw=String(server.persistentData.getString('olycity_bridges_pending') || '[]'),pending=JSON.parse(raw),keep=[]
 pending.forEach(b=>{if(b.at>olyNow()){keep.push(b);return}var pos=b.pos.join(' ');if(server.runCommandSilent('execute in '+b.dim+' if loaded '+pos+' run time query gametime')===0){keep.push(b);return}server.runCommandSilent('execute in '+b.dim+' if block '+pos+' minecraft:barrier run setblock '+pos+' minecraft:air')})
 server.persistentData.putString('olycity_bridges_pending',JSON.stringify(keep))
}

