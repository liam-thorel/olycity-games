  var lines={
    'minecraft:chicken':['Cet élevage est une société écran.','Apporte-moi trois graines. On ne se connaît pas.'],
    'minecraft:pig':['Je ne parlerai qu’en présence de mon avocat.','Ton coffre de terre ? Très suspect.'],
    'minecraft:cow':['Tu paies en herbe ou par virement ?','Le lait est gratuit. Le conseil est payant.'],
    'minecraft:sheep':['On m’a encore tondu mon budget.','Bêêê. Traduction : je te juge.']
  }
  var choices=lines[String(animal.type)];if(!choices)return
