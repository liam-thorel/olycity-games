function olyTicket(p,report) {
  if(olyRead(p,'ticket_next')>olyNow()){p.setStatusMessage('§7Patiente avant d’envoyer un autre ticket.');return 0}
  var main=p.mainHandItem,off=p.offHandItem
  var stack=main.id==='kubejs:ticket_romain'?main:(off.id==='kubejs:ticket_romain'?off:null)
  if(!stack || stack.count<1){p.setStatusMessage('§cTiens un ticket de Romain en main.');return 0}
  var safe=String(report).replace(/[§\r\n\u0000-\u001f]/g,' ').slice(0,160)
  if(!safe.trim())return 0
  stack.shrink(1);olyWrite(p,'ticket_next',olyNow()+8000)
  olyDecor(p,'Livraison express de Romain','minecraft:chest',7,false)
  var ticketOwner=String(p.getUuid())
  olyActiveTickets[ticketOwner]=(olyActiveTickets[ticketOwner] || 0)+1
  olyWrite(p,'ticket_unresolved',olyRead(p,'ticket_unresolved')+1)
  var server=p.server,author=olyName(p),authorUuid=String(p.getUuid())
  var topic=olyTicketMatch(safe),ticketPlan=null
  var result=Math.floor(Math.random()*5)
  if(topic && topic.legacy!==undefined)result=topic.legacy
  else if(topic){result=9;ticketPlan=olyTicketPick(topic)}
  var recipient=result===1?(olyFind(server,OLY.mathis) || p):p
  var recipientName=olyName(recipient),recipientUuid=String(recipient.getUuid())
  function current(name,uuid){var online=olyFind(server,name);return online && String(online.getUuid())===uuid && online.isAlive()?online:null}
  function announce(text){if(text.indexOf('Ticket signé')===0 || text.indexOf('Romain examine')===0 || text.indexOf('Rapport validé')===0)return;server.tell('§6[OLYCITY] §r'+text)}
  announce('Ticket signé Romain — En cours d’analyse… « '+safe+' »')
  olyTitle(p,'Analyse du ticket…')
  olyVisual(p,'kubejs:ticket_romain','Analyse en cours…','#78CBE0','enchant','block.note_block.pling',0.7,60)
  olyLater(server,30,()=>{
    announce('Romain examine le dossier… ça a l’air sérieux.')
    var online=current(author,authorUuid)
    if(online)olySound(online,'block.note_block.hat',1.2)
  })
  olyLater(server,60,()=>{
    var online=current(recipientName,recipientUuid)
    if(result===1){
      announce('Ticket accepté : '+recipientName+' va recevoir 64 diamants ! — Romain')
      if(online){
        olyTitle(online,'64 DIAMANTS !')
        olyVisual(online,'minecraft:diamond','64 diamants arrivent !','#64E3DC','happy_villager','entity.player.levelup',1,60)
      }
    }else{
      announce('Rapport validé. Romain prépare sa solution…')
      if(online)olyVisual(online,'kubejs:ticket_romain','Rapport validé…','#8FDF91','happy_villager','block.note_block.pling',1.4,60)
    }
  })
  // At six seconds from submission, reveal the result and only then deliver it.
  olyLater(server,120,()=>{
    var online=current(recipientName,recipientUuid),authorOnline=current(author,authorUuid)
    var awardKey='',award=0
    if(result===9){
      awardKey=olyTicketRewardKey(ticketPlan.item);award=ticketPlan.count
      announce(author+' : '+ticketPlan.text+' — Romain')
      if(online)olyVisual(online,ticketPlan.item,'Livraison : '+award+' objet'+(award>1?'s':''),'#8FDF91','happy_villager','item.book.page_turn',1,45)
    }else if(result===0){
      var liamTarget=olyFind(server,OLY.liam)
      if(liamTarget && liamTarget.isAlive() && olyRead(liamTarget,'ticket_jump_next')<=olyNow()){
        olyWrite(liamTarget,'ticket_jump_next',olyNow()+60000)
        olyPending(liamTarget,'no_jump_until',olyNow()+30000)
        liamTarget.sendData('olycity_state',{noJumpMs:30000})
        olyVisual(liamTarget,'kubejs:ticket_romain','Saut désactivé : 30 s','#E5C779','poof','entity.villager.no',0.9,40)
        announce('Ticket résolu : Liam ne peut plus sauter pendant 30 secondes. — Romain')
      }else{awardKey='ticket_slime';award=1;announce('Ticket résolu : Liam absent ou protégé par le service après-vente. Voici une consolation collante. — Romain')}
    }else if(result===1){
      awardKey='ticket_dirt';award=64
      announce('Ah mince, je m’étais trompé : c’était 64 terres. — Romain')
      if(online){
        olyTitle(online,'… 64 TERRES.')
        olyVisual(online,'minecraft:dirt','Erreur de remboursement…','#CDA07A','poof','entity.villager.no',0.7,45)
      }
    }else if(result===2){awardKey='ticket_iron';award=4;announce('Ticket résolu : compensation en fer. — Romain')}
    else if(result===3){awardKey='ticket_xp';award=40;announce('Ticket résolu : compensation en expérience. — Romain')}
    else if(result===5){awardKey='ticket_chair';award=1;announce('Tu manques de place ? Voilà une chaise, tu peux t’asseoir. — Romain')}
    else if(result===6){awardKey='ticket_clock';award=1;announce('Pour le lag, voilà une horloge. Maintenant tu peux mesurer l’attente. — Romain')}
    else if(result===7){awardKey='ticket_flower';award=1;announce('Pour les morts, voici mes condoléances. En fleur. — Romain')}
    else if(result===8){awardKey='ticket_barrel';award=1;announce('Stockage réparé : un tonneau. Le cloud était complet. — Romain')}
    else{awardKey='ticket_haste';award=1;announce('Ticket résolu : travail accéléré pour '+author+'. — Romain')}
    if(awardKey){
      var key='olycity_'+awardKey+'_'+recipientUuid
      server.persistentData.putLong(key,Number(server.persistentData.getLong(key))+award)
      if(online)olyDeliverTicket(online)
    }
    var pendingKey='olycity_ticket_unresolved_'+authorUuid
    server.persistentData.putLong(pendingKey,Math.max(0,Number(server.persistentData.getLong(pendingKey))-1))
    olyActiveTickets[authorUuid]=Math.max(0,(olyActiveTickets[authorUuid] || 0)-1)
    if(result!==1 && result!==9 && authorOnline)olyVisual(authorOnline,'kubejs:ticket_romain','Ticket résolu !','#8FDF91','happy_villager','item.book.page_turn',1,35)
  })
  return 1
}

