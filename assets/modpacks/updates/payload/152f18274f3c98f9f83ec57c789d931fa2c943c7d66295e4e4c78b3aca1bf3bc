// Relative server tick counter: independent of KubeJS scheduler's first-use clock.
var olyClockTicks=0,olyLaterJobs=[]
function olyLater(server,ticks,callback){
  olyLaterJobs.push({server:server,at:olyClockTicks+Math.max(1,Number(ticks)),callback:callback})
}
function olyProcessLater(server){
  olyClockTicks++
  var ready=[],pending=[]
  olyLaterJobs.forEach(job=>{if(job.at<=olyClockTicks)ready.push(job);else pending.push(job)})
  olyLaterJobs=pending
  ready.forEach(job=>{try{job.callback()}catch(error){console.error('[OLYCITY] Animation différée : '+error)}})
}
ServerEvents.tick(event=>olyProcessLater(event.server))

function olyToast(p) {
  var players=p.server.players
  for(var i=0;i<players.size();i++){
    var other=players.get(i)
    if(String(other.getUuid())===String(p.getUuid()) || !other.isAlive() || String(other.level.dimension)!==String(p.level.dimension))continue
    if(!other.mainHandItem || other.mainHandItem.id!=='kubejs:verre_nico')continue
    var dx=p.x-other.x,dy=p.y-other.y,dz=p.z-other.z
    if(dx*dx+dy*dy+dz*dz>16)continue
    if(olyNow()-olyRead(p,'toast_last')<30000 || olyNow()-olyRead(other,'toast_last')<30000)continue
    olyWrite(p,'toast_last',olyNow());olyWrite(other,'toast_last',olyNow())
    olyFx(p,'luck',20,0);olyFx(other,'luck',20,0)
    olySound(p,'block.amethyst_block.chime',1.5);olySound(other,'block.amethyst_block.chime',1.5)
    olyMessage(p,olyName(p)+' et '+olyName(other)+' trinquent : à OLYCITY !')
    other.setStatusMessage('§6À OLYCITY ! Chance pendant 20 s.');return
  }
}
