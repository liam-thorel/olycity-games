global.olyJunk=(p,itemId)=>{
  var id=String(itemId || p.mainHandItem.id)
  if(!olyCooldown(p,'junk_next',20))return false
  if(id==='kubejs:baton_rh'){
    // A gentle radial shove, not damage or boss control.
    var entities=olyNearby(p,4)
    for(var i=0;i<entities.size();i++){
      var e=entities.get(i)
      if(!e.living || e.player || e.maxHealth>=80 || String(e.getUuid())===String(p.getUuid()))continue
      var dx=e.x-p.x,dz=e.z-p.z,len=Math.max(.1,Math.sqrt(dx*dx+dz*dz))
      e.motionX=dx/len*.7;e.motionZ=dz/len*.7;e.motionY=.15
    }
    olyVisual(p,id,'Merci de quitter mon bureau.','#E4CE83','poof','entity.villager.no',1,30)
  }else if(id==='kubejs:poisson_chantier'){
    // Temporary passage through air only; restores only our unchanged blocks.
    var x=Math.floor(p.x),y=Math.floor(p.y)-1,z=Math.floor(p.z),placed=[],direction=((Math.round(Number(p.getYaw())/90)%4)+4)%4,stepX=[0,-1,0,1][direction],stepZ=[1,0,-1,0][direction]
    for(var n=1;n<=4;n++){
      var b=p.level.getBlock(x+n*stepX,y,z+n*stepZ)
      if(String(b.id)!=='minecraft:air')continue
      b.set('minecraft:barrier');placed.push([x+n*stepX,y,z+n*stepZ]);p.runCommandSilent('particle minecraft:end_rod '+(x+n*stepX+.5)+' '+(y+1)+' '+(z+n*stepZ+.5)+' 0.3 0.1 0.3 0 8 normal @a[distance=..24]')
    }
    var dimension=String(p.level.dimension),server=p.server
    var key='olycity_bridges_pending',raw=String(server.persistentData.getString(key) || '[]'),pending=JSON.parse(raw)
    placed.forEach(pos=>pending.push({dim:dimension,pos:pos,at:olyNow()+10000}))
    server.persistentData.putString(key,JSON.stringify(pending));olyLater(server,200,()=>olyCleanBridges(server))
    olyVisual(p,id,'Passage provisoire devant toi : 10 s.','#70C8D8','splash','block.wood.place',1,40)
  }else if(id==='kubejs:patate_secours'){
    olyWrite(p,'potato_bounce_until',olyNow()+30000)
    olyVisual(p,id,'Prochaine chute : rebond !','#E4CE83','happy_villager','block.slime_block.place',1,40)
  }
  return true
}
