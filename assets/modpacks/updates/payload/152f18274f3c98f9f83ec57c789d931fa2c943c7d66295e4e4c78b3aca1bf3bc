var olyDemoTokens={},olyDemoSerial=0
ServerEvents.commandRegistry(event=>{
  var c=event.commands,a=event.arguments
  var root=c.literal('oly').executes(ctx=>{
    var p=ctx.source.player
    p.tell('§6OLYCITY §7— /oly livre • /oly quetes • /oly bug <rapport>')
    p.tell('§7Animation : /oly animation reduite ou complete')
    if(ctx.source.hasPermission(2))p.tell('§cAdmin : /oly items • /oly cd reset [joueur] [objet] • /oly cd resetall • /oly animation test')
    return 1
  })
  root.then(c.literal('livre').executes(ctx=>{global.olyGiveChronicles(ctx.source.player);return 1}))
  root.then(c.literal('quetes').executes(ctx=>{global.olyGiveQuestBook(ctx.source.player);return 1}))
  root.then(c.literal('bug').then(c.argument('rapport',a.GREEDY_STRING.create(event)).executes(ctx=>olyTicket(ctx.source.player,a.GREEDY_STRING.getResult(ctx,'rapport')))))
  root.then(c.literal('items').requires(s=>s.hasPermission(2)).executes(ctx=>{OLY_ITEMS.forEach(id=>ctx.source.player.give('kubejs:'+id));return 1}))
  root.then(c.literal('cd').requires(s=>s.hasPermission(2) && !!s.player)
    .then(c.literal('reset').executes(ctx=>olyResetCD(ctx.source,ctx.source.player,'tous'))
      .then(c.argument('joueur',a.STRING.create(event))
        .executes(ctx=>olyResetCD(ctx.source,olyFind(ctx.source.player.server,a.STRING.getResult(ctx,'joueur')),'tous'))
        .then(c.argument('objet',a.STRING.create(event))
          .executes(ctx=>olyResetCD(ctx.source,olyFind(ctx.source.player.server,a.STRING.getResult(ctx,'joueur')),a.STRING.getResult(ctx,'objet'))))))
    .then(c.literal('resetall').executes(ctx=>{
      var players=ctx.source.player.server.players
      for(var i=0;i<players.size();i++)olyResetCD(ctx.source,players.get(i),'tous')
      return players.size()
    })))
  root.then(c.literal('animation')
    .then(c.literal('reduite').executes(ctx=>{ctx.source.player.sendData('olycity_visual_options',{reduced:1});ctx.source.player.tell('§7Animation douce activée.');return 1}))
    .then(c.literal('complete').executes(ctx=>{ctx.source.player.sendData('olycity_visual_options',{reduced:0});ctx.source.player.tell('§7Animation complète activée.');return 1}))
    .then(c.literal('test').requires(s=>s.hasPermission(2)).executes(ctx=>{
      var p=ctx.source.player,server=p.server,name=olyName(p),uuid=String(p.getUuid())
      if(server.persistentData.getString(olyKey(p,'brain_prize'))){p.setStatusMessage('§7Termine le tirage en cours avant la démonstration.');return 0}
      var token=++olyDemoSerial;olyDemoTokens[uuid]=token
      p.sendData('olycity_brain_animation',{phase:'start',prize:'minecraft:diamond_pickaxe'})
      olySound(p,'block.enchantment_table.use',0.8)
      olyLater(server,105,()=>{var current=olyFind(server,name);if(current && String(current.getUuid())===uuid && olyDemoTokens[uuid]===token){current.sendData('olycity_brain_animation',{phase:'reveal'});olySound(current,'entity.player.levelup',1.2)}})
      p.tell('§7Démonstration visuelle : aucun objet donné, aucune recharge modifiée.');return 1
    })))
  event.register(root)
})


