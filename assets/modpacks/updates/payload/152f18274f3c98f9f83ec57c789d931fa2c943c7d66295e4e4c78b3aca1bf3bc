global.olyMelon=p=>{
  var fed=0,players=p.server.players
  for(var i=0;i<players.size();i++){
    var friend=players.get(i)
    if(!friend.isAlive() || friend.isSpectator() || String(friend.level.dimension)!==String(p.level.dimension))continue
    var dx=friend.x-p.x,dy=friend.y-p.y,dz=friend.z-p.z
