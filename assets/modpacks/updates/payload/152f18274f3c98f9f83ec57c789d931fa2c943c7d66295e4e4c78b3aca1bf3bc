  var nbt={Marker:1,Invisible:ghost?1:0,Glowing:ghost?1:0,NoGravity:1,Invulnerable:1,Silent:1,ShowArms:1,NoBasePlate:1,CustomName:text,CustomNameVisible:1,Tags:['olycity_ephemeral',olyDecorSession,tag],HandItems:[{id:held,Count:1},{}],ArmorItems:[{id:'minecraft:leather_boots',Count:1},{id:'minecraft:leather_leggings',Count:1},{id:'minecraft:leather_chestplate',Count:1},{id:'minecraft:player_head',Count:1,tag:{SkullOwner:ghost?olyName(p):'ISEVEN_7'}}],Pose:{RightArm:[-80,0,0],LeftArm:[-25,0,0]}}
  p.runCommandSilent('summon minecraft:armor_stand ~ ~ ~ '+JSON.stringify(nbt).replace(JSON.stringify(nbt.Pose),'{RightArm:[-80f,0f,0f],LeftArm:[-25f,0f,0f]}'))
  var dimension=String(p.level.dimension),server=p.server
  var pending=JSON.parse(String(server.persistentData.getString('olycity_decor_pending') || '[]'));pending.push({tag:tag,dim:dimension,pos:[Math.floor(p.x),Math.floor(p.y),Math.floor(p.z)],at:olyNow()+seconds*1000});server.persistentData.putString('olycity_decor_pending',JSON.stringify(pending));olyLater(server,seconds*20,()=>olyCleanDecor(server))
  return tag
}
function olyAnimalTalk(p){
