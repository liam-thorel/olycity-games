    {
      "type": "patchouli:text",
      "text": "$(#934957)Avis de tempête$()$(br2)Le vent ne respecte pas le temps passé à construire. Hors d’une zone protégée, une tornade peut emporter des blocs.$(br2)Préparez le refuge avant de bâtir grand."
    },
    {
      "type": "patchouli:spotlight",
      "item": "weather2:weather_deflector",
      "title": "Le déflecteur météo",
      "text": "Cherchez sa recette dans JEI. Posez le déflecteur près du centre de votre zone habitée. Dans un coffre, il ne protège rien.",
      "link_recipe": false
    },
    {
      "type": "patchouli:image",
      "images": [
        "kubejs:textures/book/deflecteur.png"
